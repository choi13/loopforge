<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sbchoi.loopforge-web</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/opt/node@24/bin/npm</string>
    <string>run</string>
    <string>preview</string>
    <string>-w</string>
    <string>@loopforge/web</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/sbchoi/workspace/loopforge</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/sbchoi</string>
    <key>PATH</key>
    <string>/opt/homebrew/opt/node@24/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/sbchoi/Library/Logs/loopforge-web.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/sbchoi/Library/Logs/loopforge-web.err.log</string>
</dict>
</plist>
